{
  "name": "@researchos/shared",
  "version": "1.0.0",
  "private": true,
  "description": "Shared contracts: entities, IPC command map, error codes, ros:// links, activity events, plugin API",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contracts/index.js"
    },
    "./contracts/*": {
      "types": "./dist/contracts/*.d.ts",
      "default": "./dist/contracts/*.js"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/types/index.js"
    },
    "./types/*": {
      "types": "./dist/types/*.d.ts",
      "default": "./dist/types/*.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./activity": {
      "types": "./dist/activity.d.ts",
      "default": "./dist/activity.js"
    },
    "./entities": {
      "types": "./dist/entities.d.ts",
      "default": "./dist/entities.js"
    },
    "./ipc": {
      "types": "./dist/ipc.d.ts",
      "default": "./dist/ipc.js"
    },
    "./links": {
      "types": "./dist/links.d.ts",
      "default": "./dist/links.js"
    },
    "./plugin-api": {
      "types": "./dist/plugin-api.d.ts",
      "default": "./dist/plugin-api.js"
    },
    "./i18n/*": {
      "types": "./dist/i18n/*.d.ts",
      "default": "./dist/i18n/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}